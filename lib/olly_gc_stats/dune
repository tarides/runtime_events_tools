(executable
 (name discover)
 (modules discover)
 (libraries dune-configurator))

(rule
 (targets gc_counters_shim.suffix olly_gc_stats.suffix)
 (action (run ./discover.exe)))

(library
 (name olly_gc_stats)
 (modules
  (:standard \ discover))
 (optional)
 ; only needed during development by 'dune build @lint'
 ; not required for building if you haven't changed
 ; the source code
 (lint
  (per_module
   ((pps ppx_deriving_jsont)
    json)))
 (libraries olly_common hdr_histogram jsont jsont.bytesrw))

 (rule
   (copy# "olly_gc_stats.%{read-lines:olly_gc_stats.suffix}.ml" "olly_gc_impl.ml"))

 (rule
   (copy# "gc_counters_shim.%{read-lines:gc_counters_shim.suffix}.ml" "gc_counters_shim.ml"))
